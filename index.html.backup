<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AGV智能小车操作系统</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="css/common.css">
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#4080FF",
              secondary: "#0FC6C2",
              success: "#62C462",
              warning: "#EE9A49",
              danger: "#F53F3F",
              dark: "#1D2129",
              "gray-light": "#F2F3F5",
              "gray-dark": "#4E5969",
              "gray-deep": "#909399",
              "card-bg": "#FFFFFF",
              light: "#f5f7fa"
            }
          }
        }
      };
    </script>
  </head>
  <body class="bg-gray-100 h-screen m-0 p-0 flex items-center justify-center">
    <div class="text-center">
      <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-6 float-animation">
        <i class="fa fa-robot text-white text-4xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-dark mb-4">AGV智能小车操作系统</h1>
      <p class="text-gray-deep mb-8">v2.0.0 - 请点击下方按钮进入系统</p>
      <a href="pages/login.html" class="inline-block px-8 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-all text-lg font-medium shadow-lg">
        <i class="fa fa-rocket mr-2"></i>启动系统
      </a>
    </div>
  </body>
</html>
